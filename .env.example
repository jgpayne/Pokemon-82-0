# Local port for http://localhost:<PORT>
PORT=8080

# Leave empty for a free quick tunnel (random https://*.trycloudflare.com link,
# no Cloudflare account needed, new URL on every restart).
# Set it to a Cloudflare Zero Trust tunnel token for a stable URL on your own domain.
CLOUDFLARE_TUNNEL_TOKEN=

# Transport to Cloudflare's edge, both on port 7844: http2 uses TCP, quic
# (cloudflared's default) uses UDP. Use auto to let cloudflared pick.
TUNNEL_PROTOCOL=http2
